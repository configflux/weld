package(default_visibility = ["//visibility:public"])

# ONE DECLARATION PER LINE. Starlark lets a `#` swallow every statement that
# follows it on the same line, so a target folded in behind a comment silently
# ceases to exist -- that has cost this file two live targets (bd impz:
# //tools:lint_line_counts_test; bd wbz8: :weld_yaml_block_scalar_test, dead
# until the check that now guards them was written). //tools:lint_test_wiring
# fails the gate if it recurs; the headroom below -- coherent groups extracted
# into weld/tests/*.bzl macros (bd hpv7) -- is what keeps the shortcut from
# being tempting again. A macro-declared target stays fully visible to that
# lint, which resolves through `bazel query`, not BUILD text.

filegroup(
    name = "fixture_files",
    srcs = glob(["fixtures/**"]),
)
filegroup(name = "bench_prompts", srcs = ["//weld/tests/bench:prompts.yaml"])
filegroup(name = "bench_quality_cases", srcs = ["//weld/tests/bench:quality_cases.yaml"])

# Shared tree-sitter skip-or-fail policy (bd 9txq). Lives on the shipping
# side of the publish boundary because shipping targets here and in bench/
# depend on it, while tools/ is publishignored wholesale -- a //tools home
# made the public `bazel build //...` fail at load time (bd fkmvv, aborted
# the v0.23.0 release). imports = ["."] exposes it as the top-level module
# `tier_check_grammar_gate` for every consumer, tools/ gates included.
# Deliberately depends on //weld/strategies only -- it reads
# TREE_SITTER_AVAILABLE, and the grammar wheels belong to the consuming
# gate target, not here.
py_library(
    name = "tier_check_grammar_gate",
    srcs = ["tier_check_grammar_gate.py"],
    imports = ["."],
    deps = ["//weld/strategies"],
)

py_library(name = "graph_invariants_lib", srcs = ["_graph_invariants.py", "_contract_markers.py", "_golden_invariants.py", "_golden_violation_fixtures.py", "_staleness_invariants.py"], deps = ["//weld:runtime", "//weld:workspace"])  # bd 5038-fprr2 / ADR 0139 mechanism 4: _contract_markers.py rides in this library rather than becoming its own, because it exists only to feed _graph_invariants._CANNOT_ANSWER_MARKERS -- one dep for a consumer, and no second label to keep pointed at the first. It derives those markers from weld/_errors.py instead of restating the four literals that used to sit inline; //weld:runtime already carries _errors.py, so the split needs no new dep. bd 5038-hdutn / ADR 0139: the shared graph invariants (edges resolve, no first-party external, no orphan stubs, the cannot-answer shape) as ONE importable target. //weld:runtime is here for bd 5038-ekohj's assert_no_orphan_stubs, which must DERIVE its verdict from the production union _discover_external_package_purge.emptied_placeholder_node_ids rather than restate five purge predicates test-side (ADR 0139 mechanism 6); that is the target owning all five purge modules, and it already carries //weld/strategies, which _discover_resolved_stub_purge imports. They used to ride in the field-eval targets' srcs on the recorded premise that they were "test data, not a surface anything imports outside these targets"; the test-quality program falsifies it -- the golden families and the purge family need the same helpers -- and the alternative to a library is a 300-line module copied into a dozen more srcs lists, which is how a shared invariant silently forks into a dozen slightly different ones. Declared here rather than inside field_eval_tests.bzl so a consumer outside that family does not depend on a target that exists only as its side effect. bd 5038-ipa1e / ADR 0139 mechanism 5 adds _golden_invariants.py (the hook the four golden families call on both their compare and their regen payloads) and _golden_violation_fixtures.py (the three producer-minted violations those families inject) to the same srcs rather than to a second library: both exist only to serve _graph_invariants to the golden families, and a separate label would be one more thing to keep pointed at this one. bd 5038-dgqgr widened weld_graph_invariants_wiring_test's claim scan from _graph_invariants.py alone to this whole srcs list, read off the same Starlark scan rather than restated: every module declared here is claim-policed, and a fifth is policed the day it joins rather than the day someone remembers the guard. That list is derived, not named, so its own vacuity floor (_MUST_BE_OWNED) names the two modules this target must still declare. bd 5038-lcq0c.1 / ADR 0141 D1 adds _staleness_invariants.py: the 'a stale verdict names its basis' contract the M1 red probe asserts and the M1 fix's own unit test will assert next to it. It belongs beside assert_roster_matches_json in _graph_invariants.py -- same family, same wd stale --json payload -- and sits in its own module only because that file is at the 400-line cap; a second label for one function would be the thing this comment keeps arguing against
py_test(name = "weld_graph_invariants_wiring_test", srcs = ["weld_graph_invariants_wiring_test.py"], data = ["BUILD.bazel"] + glob(["*.bzl"]), deps = ["//weld/strategies"])  # bd 5038-hdutn: the mechanism under the library above -- exactly one rule in this package may claim a module :graph_invariants_lib declares in srcs, and it must be that library. bd 5038-dgqgr widened it from the single named _graph_invariants.py to the owner's whole srcs list, because three more shared modules had since joined that library under nothing but convention -- the state the guard exists to end. data carries BUILD.bazel AND every macro file because targets_in does not expand a macro CALL: the BUILD file yields its own declarations, each *_tests.bzl yields its macro body's, and a guard blind to either half would miss whichever one a future srcs copy lands in
py_test(name = "graph_invariants_cannot_answer_markers_test", srcs = ["graph_invariants_cannot_answer_markers_test.py"], deps = [":graph_invariants_lib", "//weld:runtime", "//weld:workspace"])  # bd 5038-fprr2 / ADR 0139 mechanisms 4 and 3 + architect ruling R8: two claims in one target because they are two halves of one contract -- the marker set is derived from weld/_errors.py, AND the producers that never read those tables (impact_format's Risk line, _impact_cannot_answer's reason prose, _graph_cli's hand-copied graph-missing block) still say what was derived. The R8 cases assert on each producer's output ALONE: the CLI writes format_error_line to stderr for every refusal, so a check over the combined streams would pass on that prefix no matter how far the renderer had drifted. //weld:workspace is direct rather than inherited: the fixture mints its repo node with the real federation_root._build_repo_node from a ChildEntry (ADR 0139 mechanism 1) instead of a node literal that could drift from the props the cannot-answer rule keys on
py_test(name = "graph_invariants_remediation_markers_test", srcs = ["graph_invariants_remediation_markers_test.py"], deps = [":graph_invariants_lib", "//weld:runtime"])  # bd 5038-hkb8x / ADR 0139 mechanisms 4 and 3: the sibling of the target above, for assert_cannot_answer's OTHER marker set. Its own target rather than more cases in that file because the two sets answer to different producers -- that one to the _DEFAULT_ERROR summaries, this one to format_error_line's hint label, structured_payload's retry field and the ERROR_HINTS imperatives -- and because folding these hundred-odd lines into that 337-line file would have carried it past the 400-line cap in the same change. No //weld:workspace, unlike its sibling: nothing here mints a repo node, so the graph-missing block and the error tables are the whole surface. The mechanism-3 case is the one that needs //weld:runtime directly: _graph_cli.missing_graph_message spells "Then retry:" itself, a second producer of the label weld/_errors.py owns, and the parity assertion reads the expected value off structured_payload rather than restating it
py_test(name = "graph_invariants_orphan_stubs_test", srcs = ["graph_invariants_orphan_stubs_test.py"], deps = [":graph_invariants_lib", "//weld:runtime"])  # bd 5038-ekohj / ADR 0139 mechanism 6: assert_no_orphan_stubs must stay a thin assertion over the production union emptied_placeholder_node_ids, so the load-bearing case patches that union and proves a hypothetical sixth purge rule reaches the invariant with no edit to it -- a re-implemented predicate here would ignore the patch and pass. The //weld:runtime dep is direct rather than inherited: this test mints its placeholder with the real weld.graph_closure._ensure_package_node (ADR 0139 mechanism 1) instead of a hand-written node literal that could drift from the props the purge rule keys on
py_test(name = "weld_golden_invariant_hook_test", srcs = ["weld_golden_invariant_hook_test.py"], data = [":fixture_files", ":demo_discover_golden_files"], deps = [":graph_invariants_lib", "//weld:runtime", "//weld:workspace"])  # bd 5038-ipa1e / ADR 0139 mechanism 5: the contract the four golden families lean on -- each of them proves the hook is wired into its own compare AND regen path, this proves the hook rejects the three violation classes and cannot check nothing without saying so. Both goldens are data because the payloads under test start as producer output read off disk rather than as node literals (mechanism 1): :fixture_files carries the single-repo blast-radius graph, :demo_discover_golden_files the federated polyrepo root whose cross-repo edge is the only one in the tree that needs a child roster to resolve. //weld:workspace is direct, not inherited: the federated cases partition endpoints on the real UNIT_SEPARATOR rather than a re-typed \x1f

# Subprocess lane -- every sh_test, i.e. weld driven as a real process.
subprocess_tests()

py_test(name = "weld_package_init_wiring_test", srcs = ["weld_package_init_wiring_test.py"], data = ["//weld:BUILD.bazel", "//weld:runtime_srcs.bzl"], deps = ["//weld:package_init"])  # bd p07k: weld/__init__.py must reach every runfiles tree as the REAL file. Where it does not, Bazel synthesises an empty one, and a tree built with the generated form concurrently with trees holding the symlink form writes through the symlink and truncates the live source -- invisible, because ADR 0099 makes that file empty, so the truncation is byte-identical and costs only every skipped disk-cache upload. The dep on //weld:package_init is not decoration: without it this very target would be the next tree carrying the generated form

[py_test(name = _n, srcs = [_n + ".py"], deps = ["//weld:contract", "//weld:runtime"]) for _n in ("weld_stale_source_test", "weld_drift_is_graph_only_test", "weld_stale_sources_bound_test", "weld_stale_no_graph_test", "weld_stale_check_exit_test","weld_dirty_worktree_staleness_test", "weld_touch_test", "weld_missing_graph_guidance_test", "weld_graph_validate_diagnostics_test", "weld_validate_federation_gate_test", "weld_errors_test", "weld_cli_error_contract_test", "weld_terminal_sanitization_test", "weld_json_terminal_safety_test", "weld_mcp_server_errors_test", "weld_diff_corrupt_graph_test", "weld_mcp_freshness_test", "weld_bookkeeping_paths_contract_test")]  # weld_dirty_worktree_staleness_test: ADR 0017 working-tree dimension (uncommitted edits mark stale; bookkeeping dirt does not). bd eqc4: weld_bookkeeping_paths_contract_test is its structural half -- it pins every managed .weld/.gitignore template line into WELD_BOOKKEEPING_PATHS, so a new sidecar cannot be gitignored (the visible half of the change) without also being excluded from source drift (the invisible half that has now been forgotten four times). weld_drift_is_graph_only_test / weld_stale_sources_bound_test: split from weld_stale_source_test to hold it under the line-count cap (bd 5038-4625)
