# The cpp grammar precondition shared by the adapter test targets below
# (bd gjli). It deliberately does NOT declare the two wheels itself:
# every user must name @pypi//tree_sitter + @pypi//tree_sitter_cpp in its
# own deps, which is exactly what the helper's diagnostic tells a fixer
# to restore here. Granting them transitively would let a target satisfy
# the guard while declaring nothing.
py_library(
    name = "bench_grammar_precondition",
    srcs = ["bench_grammar_precondition.py"],
    deps = [
        ":package_init",
        "//weld:runtime",
        # adapters/weld.py -- whose _is_tree_sitter_available the helper
        # probes -- is a public_bench_lib source, not a bench_lib one.
        "//weld/bench:public_bench_lib",
        # The shared skip-or-fail-on-missing-grammar branch policy (bd
        # 9txq); this library still owns its own probe and reason/labels.
        "//weld/tests:tier_check_grammar_gate",
    ],
)

bench_py_test(
    name = "bench_grammar_precondition_test",
    srcs = ["bench_grammar_precondition_test.py"],
    # Declares both wheels for its consumers' reason and one more:
    # test_both_present_under_bazel_reports_nothing_missing asserts the
    # probe finds them, so dropping a label fails the guard's coverage.
    # //weld/bench:bench_lib added for bd 5038-30of: this target staged
    # weld/bench/adapters/*.py (via :public_bench_lib) without ever staging
    # weld/bench/__init__.py itself -- confirmed empirically via
    # `bazel query deps(...)`, the exact bd p07k hazard one level down.
    deps = [
        ":bench_grammar_precondition",
        "//weld:runtime",
        "//weld/bench:bench_lib",
        "//weld/bench:public_bench_lib",
        "@pypi//tree_sitter",
        "@pypi//tree_sitter_cpp",
    ],
)

bench_py_test(
    name = "weld_public_bench_weld_adapter_test",
    srcs = ["weld_public_bench_weld_adapter_test.py"],
    # Both wheels are pinned in requirements_lock.txt, so the
    # tree-sitter-gated case below runs in every lane instead of skipping
    # green wherever the host lacked an ambient grammar (bd srzy,
    # following bd c42b). tree_sitter_cpp specifically: the cpp
    # extraction path is that case's bug class, and the precondition now
    # probes it rather than only the umbrella (bd gjli).
    deps = [
        ":bench_grammar_precondition",
        "//weld:runtime",
        "//weld/bench:bench_lib",
        "//weld/bench:public_bench_lib",
        "@pypi//tree_sitter",
        "@pypi//tree_sitter_cpp",
    ],
)

