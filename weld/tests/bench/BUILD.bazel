])

# The one home for weld/tests/bench/__init__.py as a Python source (mirrors
# //weld:package_init's rationale exactly, bd p07k). Before bd 5038-30of this
# directory had THREE independent literal "__init__.py" srcs declarations
# (:bench_test_helpers, :federation_bench_helpers, :bench_grammar_precondition)
# and 13 py_test targets reaching none of them -- so those 13 runfiles trees
# took Bazel's synthesised empty init while any sibling depending on one of
# the three took the real (symlinked) one. Same dual-treatment race bd p07k
# fixed at the weld/ root; lint_package_init_runfiles.py now sweeps every
# wired subpackage, not just the root, so a future omission here fails the
# gate instead of racing silently.
py_library(
    name = "package_init",
    srcs = ["__init__.py"],
)

py_library(
    name = "bench_test_helpers",
    srcs = ["bench_test_helpers.py"],
    deps = [
        ":package_init",
        "//weld:contract",
    ],
)

