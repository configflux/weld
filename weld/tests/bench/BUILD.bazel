# Lazy per-query inverted-index over a 30-child federation.
# Measures RSS and latency vs the JSON-only baseline.
#
# flaky = True: the latency assertion compares sqlite p95 against
# the JSON path's p95 with a 2.0x ceiling. On shared CI runners the
# sqlite cold-cache p95 can occasionally exceed 2.0x due to per-query
# inverted-index read jitter, not a real regression. Bazel auto-retries
# (default 3 attempts) absorb that jitter without loosening the
# assertion itself. The deeper fix is an eager federation inverted-index
# aggregation that removes the cold-cache cost by construction; promote
# that follow-up if this target still trips repeatedly under the retry
# budget.
py_test(
    name = "weld_federation_query_test",
    srcs = ["weld_federation_query_test.py"],
    flaky = True,
    local = True,
    tags = ["no-sandbox"],
    deps = [
        ":federation_bench_helpers",
        "//weld:runtime",
        "//weld:workspace",
    ],
)

# Opt-in eager inverted-index aggregation benchmark. Compares the
# eager path (constructed with eager_index=True) against the lazy
# default on the same N=30 fixture; asserts eager beats lazy by at
# least the documented margin and the construction-time tax stays
# bounded. flaky=True absorbs shared-CI jitter the same way the lazy
# benchmark does; the assertion itself is the regression canary.
py_test(
    name = "weld_federation_eager_test",
    srcs = ["weld_federation_eager_test.py"],
    flaky = True,
    local = True,
    tags = ["no-sandbox"],
    deps = [
        ":federation_bench_helpers",
        "//weld:runtime",
        "//weld:workspace",
    ],
)

