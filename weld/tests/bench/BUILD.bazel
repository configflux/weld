# Wall-clock measurement targets carry the "benchmark" tag: they are
# excluded from the default and CI parallel test runs and execute on the
# dedicated serial lane (`bazel test --config=benchmark`, --local_test_jobs=1).
# Running them un-contended is the root-cause fix for the parallel-load
# jitter that previously forced `flaky=True` (bd ...yzfw / ...2c19). Their
# correctness/determinism invariants gate; their latency/drift numbers are
# advisory (printed for triage), never asserted, so they cannot flake.
py_test(
    name = "weld_federation_benchmark_test",
    srcs = ["weld_federation_benchmark_test.py"],
    local = True,
    tags = ["benchmark", "no-sandbox"],
    deps = [
        ":federation_bench_helpers",
        "//weld:runtime",
        "//weld:workspace",
    ],
)

# ADR 0058 memory-peak probe: split from the benchmark test so each
# file stays under the project line-count cap.
py_test(
    name = "weld_federation_memory_probe_test",
    srcs = ["weld_federation_memory_probe_test.py"],
    local = True,
    tags = ["benchmark", "no-sandbox"],
    deps = [
        ":federation_bench_helpers",
        "//weld:runtime",
        "//weld:workspace",
    ],
)

# Lazy per-query inverted-index over a 30-child federation. Gates on the
# structural invariant (sqlite children serve queries without populating
# the JSON cache) and the headline RSS memory win; latency ratios are
# advisory. Serial benchmark lane (see comment above) replaces the former
# flaky=True retry budget.
py_test(
    name = "weld_federation_query_test",
    srcs = ["weld_federation_query_test.py"],
    local = True,
    tags = ["benchmark", "no-sandbox"],
    deps = [
        ":federation_bench_helpers",
        "//weld:runtime",
        "//weld:workspace",
    ],
)

# Opt-in eager inverted-index aggregation benchmark (ADR 0063). Gates on
# correctness (eager and lazy return identical query results) and that the
# eager index is actually built; the eager-vs-lazy latency speedup and
# construction tax are advisory. Serial benchmark lane replaces flaky=True.
py_test(
    name = "weld_federation_eager_test",
    srcs = ["weld_federation_eager_test.py"],
    local = True,
    tags = ["benchmark", "no-sandbox"],
    deps = [
        ":federation_bench_helpers",
        "//weld:runtime",
        "//weld:workspace",
    ],
)

