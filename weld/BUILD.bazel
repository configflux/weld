load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load(":runtime_srcs.bzl", "RUNTIME_SRCS")

package(default_visibility = ["//visibility:public"])

# Exported so //tools:version_consistency_test can stage pyproject.toml in
# its runfiles and read the PEP 621 `version = "..."` field at test time.
# Keeping the export line-oriented (rather than a filegroup) mirrors the
# convention used by the repo root BUILD.bazel for VERSION and similar
# source-of-truth files.
#
# BUILD.bazel and runtime_srcs.bzl are exported for the same kind of reason:
# //weld/tests:weld_package_init_wiring_test stages this package's own
# declarations in its runfiles and reads them, because the rule it holds --
# one home for weld/__init__.py, below -- is a property of how the targets are
# declared and cannot be observed from inside a built one (bd p07k).
exports_files([
    "BUILD.bazel",
    "pyproject.toml",
    "runtime_srcs.bzl",
])

# Every .py file that EXISTS in this package, as opposed to every one some
# target declares. //weld/tests:weld_runtime_srcs_claim_test set-diffs the two
# to catch a module that is on disk but claimed by no target -- the bd 73xa
# ModuleNotFoundError shape. A glob is required rather than convenient: staging
# the declared sources instead would make the test enumerate exactly the set it
# is supposed to be checking against, and it would pass vacuously (bd tnz3).
filegroup(
    name = "all_python_sources",
    srcs = glob(["*.py"]),
)

filegroup(
    name = "module_entrypoint",
    # Both files are required so that `import weld` from an sh_test runfiles
    # tree resolves to a regular package (with __file__ set), not an implicit
    # namespace package. Without __init__.py Python treats the runfiles
    # weld/ directory as a namespace package and weld.__file__ becomes
    # None, which breaks any test that calls `Path(weld.__file__).parent`.
    srcs = [
        "__init__.py",
        "__main__.py",
    ],
)

# The one home for weld/__init__.py as a Python source.
#
# Every runfiles tree that carries any weld/*.py needs a weld/__init__.py, and
# Bazel will supply one itself (legacy_create_init) when the target does not
# bring the real file. That leaves the package with two treatments -- 11 trees
# holding a GENERATED empty file, 59 holding a symlink to the live source --
# and the two are not interchangeable at build time: a tree being constructed
# with the generated form, concurrently with trees holding the symlink form,
# writes through the symlink and truncates the live source. Serialised
# (--jobs=2 --local_test_jobs=1) the interleaving never happens; in parallel it
# does (bd p07k, forensics and the refuted hypotheses in bd w3n6).
#
# It is invisible rather than harmless. ADR 0099 requires weld/__init__.py to
# be empty, so truncating it is byte-identical and `git status` stays clean --
# but the bumped ctime reads to Bazel as a concurrent modification of an input
# to hundreds of py targets, and every one of them skips its disk-cache upload.
#
# So: exactly one declaration, and every py_ target in this package takes it
# from here. //weld/tests:weld_package_init_wiring_test fails the gate if a new
# target skips it.
py_library(
    name = "package_init",
    srcs = ["__init__.py"],
)

py_library(
    name = "yaml",
    srcs = [
        "_yaml.py",
        "_yaml_block_scalar.py",
    ],
    deps = [":package_init"],
)

# Tiny, zero-dep canonical-id library (ADR 0041 § Layer 1). Exposed as
# its own target so leaf packages (e.g. //weld/cross_repo) can depend
# on it without pulling in the full :runtime cycle.
py_library(
    name = "node_ids",
    srcs = ["_node_ids.py"],
    deps = [":package_init"],
)

py_library(
    name = "safe_text",
    srcs = ["_safe_text.py"],
    deps = [":package_init"],
)

# Tiny, stdlib-only repo-relative path library: the canonical POSIX form, the
# construction helper that builds it, and the platform-aware fold that repairs
# a foreign spelling (bd pbi8, bd v552). Its own target, like :node_ids, so the
# strategies package can spell an index path the same way weld does without a
# cycle back through :runtime -- ``dirty_matched`` has to agree with
# ``_source_resolve`` exactly, and an inline second copy of that rule is what
# the fold exists to survive.
py_library(
    name = "rel_path",
    srcs = ["_rel_path.py"],
    deps = [":package_init"],
)

# Stdlib-only stderr notice chokepoint. Its own target so leaf packages
# (//weld/cross_repo, :contract) can emit notices without a cycle
# through :runtime.
py_library(
    name = "notice",
    srcs = ["_notice.py"],
    deps = [
        ":package_init",
        ":safe_text",
    ],
)

# Low-level registries imported by leaf strategy modules (weld/strategies/*)
# as well as by runtime. They are their own micro-libraries so the strategies
# library can depend on them without a cycle through //weld:runtime.
py_library(
    name = "graph_node_registry",
    srcs = ["_graph_node_registry.py"],
    deps = [":package_init"],
)

py_library(
    name = "capabilities_registry",
    srcs = [
        "_capabilities_registry.py",
        "_capabilities_registry_missing.py",
        "_capabilities_registry_types.py",
    ],
    deps = [":package_init"],
)

# Zero-dep unresolved-sentinel purge predicate (bd oao53). Its own
# micro-library, like :graph_node_registry above, so
# weld/strategies:cpp_resolver.py can call it directly (bd 5038-t6mzx)
# without a cycle through //weld:runtime, which already depends on
# //weld/strategies.
#
# _discover_placeholder_anchor.py rides in this srcs list rather than
# becoming a library of its own (bd 5038-q4t3d), the same call
# :capabilities_registry above makes: it exists only to answer "what still
# anchors a never-walked placeholder" for the purge rule beside it and for
# //weld:runtime's _discover_resolved_stub_purge, so a second label would be
# one more thing to keep pointed at this one. It must be HERE and not only in
# RUNTIME_SRCS, because the import above is what cpp_resolver reaches through
# on the no-cycle path this micro-library exists to provide.
py_library(
    name = "discover_unresolved_symbol_purge",
    srcs = [
        "_discover_placeholder_anchor.py",
        "_discover_unresolved_symbol_purge.py",
    ],
    deps = [":package_init"],
)

# Zero-dep ADR 0103 node-claim veto (bd tuuve). Its own micro-library, like
# :discover_unresolved_symbol_purge above, so weld/strategies/cpp_cmake.py
# and weld/strategies/_cmake_packages.py can call claim_supersedes directly
# -- guarding their own intra-strategy multi-file node accumulation against
# the same order-dependent clobber ADR 0103 already vetoes at the
# orchestrator's cross-source-entry merge -- without a cycle through
# //weld:runtime, which already depends on //weld/strategies.
py_library(
    name = "discover_node_merge",
    srcs = ["_discover_node_merge.py"],
    deps = [":package_init"],
)

py_library(
    name = "git",
    # _git_worktree.py (ADR 0096) and _git_bookkeeping.py (bd eqc4) are
    # overflow siblings of _git.py, which is at the 400-line cap: same
    # zero-dep subprocess-git profile, so they ride the same micro-library
    # rather than forcing a new target on every dep. _git_bookkeeping.py
    # imports nothing at all -- it holds only the never-user-source set.
    srcs = ["_git.py", "_git_bookkeeping.py", "_git_worktree.py"],
    deps = [":package_init"],
)

py_library(
    name = "repo_boundary",
    srcs = ["repo_boundary.py"],
    deps = [":package_init"],
)

py_library(
    name = "glob_match",
    srcs = ["glob_match.py"],
    deps = [
        ":package_init",
        ":repo_boundary",
    ],
)

py_library(
    name = "contract",
    srcs = [
        "_confidence_defaults.py",
        "_confidence_warn.py",
        "_contract_edge_validators.py",
        "_contract_types.py",
        "_contract_validators.py",
        "_federation_validate.py",
        "_graph_doc_validators.py",
        "_validate_diagnostics.py",
        "contract.py",
    ],
    deps = [
        ":notice",
        ":package_init",
    ],
)

py_library(
    name = "workspace",
    srcs = [
        "_federation_endpoints.py",
        "_gitignore_scan.py",
        "_workspace_schema.py",
        "workspace.py",
        "workspace_dump.py",
        "workspace_scan.py",
        "workspace_scan_filter.py",
    ],
    deps = [
        ":glob_match",
        ":package_init",
        ":yaml",
    ],
)

py_library(
    name = "runtime",
    srcs = RUNTIME_SRCS,
    # These two asset directories ship whole -- the viz server serves whatever
    # is under static/, demos run whatever is under scripts/ -- so they are
    # globbed rather than enumerated: a new vendor file or demo script cannot
    # then be added without being packaged. Same convention as
    # //weld/languages and the //weld/tests fixtures filegroup.
    data = glob(["demos/scripts/*.sh", "viz/static/**"]) + [
        "//weld/languages:query_files",
        "//weld/templates",
    ],
    deps = [
        ":capabilities_registry",
        ":contract",
        ":git",
        ":glob_match",
        ":graph_node_registry",
        ":notice",
        ":package_init",
        ":repo_boundary",
        ":safe_text",
        ":yaml",
        "//weld/cross_repo",
        "//weld/strategies",
    ],
)

py_binary(
    name = "cli",
    srcs = ["__main__.py"],
    main = "__main__.py",
    deps = [
        ":package_init",
        ":runtime",
        "//weld/bench:bench_lib",
    ],
)
